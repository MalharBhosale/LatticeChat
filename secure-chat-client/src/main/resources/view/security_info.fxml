<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.securechat.client.controller.SecurityInfoController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            prefWidth="560" prefHeight="650" styleClass="security-scroll-pane">
    <content>
        <VBox spacing="14" styleClass="security-dialog-root">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <VBox spacing="4">
                <Label text="🛡️ Post-Quantum Security Verification" styleClass="dialog-title"/>
                <Label fx:id="peerNameLabel" text="@peer" styleClass="dialog-subtitle"/>
            </VBox>

            <Separator/>

            <!-- Safety Number -->
            <VBox alignment="CENTER" spacing="6" styleClass="safety-card">
                <padding>
                    <Insets top="12" right="16" bottom="12" left="16"/>
                </padding>
                <Label text="VERIFICATION SAFETY NUMBER" styleClass="card-subtitle"/>
                <Label fx:id="safetyNumberLabel" text="000000 000000" styleClass="safety-number"/>
                <Label text="Compare this number out-of-band with your contact to verify end-to-end security." styleClass="card-hint"/>
            </VBox>

            <!-- Fingerprints -->
            <VBox spacing="10">
                <VBox spacing="3">
                    <Label text="Peer ML-DSA-65 Identity Key Fingerprint" styleClass="field-label"/>
                    <Label fx:id="peerFingerprintLabel" text="Loading..." wrapText="true" styleClass="fingerprint-label"/>
                </VBox>

                <VBox spacing="3">
                    <Label text="Your ML-DSA-65 Identity Key Fingerprint" styleClass="field-label"/>
                    <Label fx:id="localFingerprintLabel" text="Loading..." wrapText="true" styleClass="fingerprint-label"/>
                </VBox>
            </VBox>

            <!-- Key Management & Rotation Card -->
            <VBox spacing="8" styleClass="safety-card">
                <padding>
                    <Insets top="10" right="14" bottom="10" left="14"/>
                </padding>
                <VBox spacing="2">
                    <Label text="KEY LIFECYCLE &amp; SESSION CONTROL" styleClass="card-subtitle"/>
                    <Label fx:id="keyVersionLabel" text="Active Key Version: v1" styleClass="inspector-value"/>
                    <Label fx:id="rotationStatusLabel" text="" wrapText="true" styleClass="card-hint"/>
                </VBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="btnRotatePrekey" text="🔄 Rotate Prekey" onAction="#handleRotatePrekey"
                            styleClass="secondary-button"/>
                    <Button fx:id="btnRenegotiateSession" text="⚡ Re-negotiate Session" onAction="#handleRenegotiateSession"
                            styleClass="secondary-button"/>
                    <Button fx:id="btnRevokeKey" text="⚠️ Revoke Bundle" onAction="#handleRevokeKey"
                            styleClass="danger-button"/>
                </HBox>
            </VBox>

            <!-- Audit Trail Section -->
            <VBox spacing="6" styleClass="safety-card">
                <padding>
                    <Insets top="10" right="14" bottom="10" left="14"/>
                </padding>
                <HBox alignment="CENTER_LEFT">
                    <Label text="CRYPTOGRAPHIC AUDIT TRAIL" styleClass="card-subtitle" HBox.hgrow="ALWAYS"/>
                    <Button text="📋 Refresh" onAction="#handleRefreshAuditTrail" style="-fx-font-size: 11px; -fx-padding: 3 8;"/>
                </HBox>
                <VBox fx:id="auditLogsContainer" spacing="5" maxHeight="150">
                    <Label text="Loading audit trail..." styleClass="card-hint"/>
                </VBox>
            </VBox>

            <!-- Algorithms in use -->
            <VBox spacing="4" styleClass="algo-box">
                <padding>
                    <Insets top="8" right="10" bottom="8" left="10"/>
                </padding>
                <Label text="CRYPTOGRAPHIC PRIMITIVES APPLIED" styleClass="card-subtitle"/>
                <Label fx:id="algorithmsLabel" wrapText="true" styleClass="algo-text"/>
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Close" onAction="#handleClose" styleClass="primary-button" minWidth="90"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
