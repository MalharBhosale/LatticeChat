<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.securechat.client.controller.MessageInspectorController"
      spacing="12" styleClass="security-dialog-root" prefWidth="620" prefHeight="580">
    <padding>
        <Insets top="20" right="22" bottom="20" left="22"/>
    </padding>

    <!-- Header -->
    <VBox spacing="3">
        <Label text="🔬 Cryptographic Message Inspector" styleClass="dialog-title"/>
        <Label text="Post-Quantum Forensic Inspection (NIST FIPS 203 &amp; 204)" styleClass="dialog-subtitle"/>
    </VBox>

    <Separator/>

    <!-- Message Summary Card -->
    <GridPane hgap="12" vgap="6" styleClass="inspector-grid">
        <columnConstraints>
            <ColumnConstraints minWidth="130" prefWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Message UUID:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="messageIdLabel" styleClass="inspector-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Sequence &amp; Status:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="1">
            <Label fx:id="sequenceLabel" styleClass="inspector-badge"/>
            <Label fx:id="directionLabel" styleClass="inspector-value"/>
            <Label fx:id="timestampLabel" styleClass="card-hint"/>
        </HBox>

        <Label text="Post-Quantum KEM:" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="kemAlgorithmLabel" styleClass="inspector-pqc-kem" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Digital Signature:" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <HBox spacing="6" alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="1">
            <Label fx:id="dsaStatusLabel" styleClass="inspector-verified-badge"/>
            <Label fx:id="dsaAlgorithmLabel" styleClass="inspector-value"/>
        </HBox>

        <Label text="Symmetric Cipher:" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <Label fx:id="aesCipherLabel" styleClass="inspector-value" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Nonce (96-bit Hex):" styleClass="field-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <Label fx:id="nonceLabel" styleClass="inspector-mono" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Session Fingerprint:" styleClass="field-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <Label fx:id="sessionFingerprintLabel" styleClass="inspector-mono" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Peer Safety Number:" styleClass="field-label" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <Label fx:id="safetyNumberLabel" styleClass="inspector-safety" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
    </GridPane>

    <!-- Raw JSON Envelope View -->
    <VBox spacing="4" VBox.vgrow="ALWAYS">
        <Label text="RAW CRYPTOGRAPHIC ENVELOPE (JSON)" styleClass="card-subtitle"/>
        <TextArea fx:id="rawJsonArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                  styleClass="raw-json-area"/>
    </VBox>

    <!-- Close Button -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Close Inspector" onAction="#handleClose" styleClass="primary-button" minWidth="120"/>
    </HBox>
</VBox>
