<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.securechat.client.controller.ChatController"
            styleClass="chat-root">

    <!-- Left Sidebar -->
    <left>
        <VBox spacing="14" styleClass="sidebar">
            <padding>
                <Insets top="16" right="14" bottom="16" left="14"/>
            </padding>

            <!-- User Profile Header -->
            <VBox spacing="4" styleClass="user-header-card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="👤" style="-fx-font-size: 20px;"/>
                    <VBox spacing="2">
                        <Label fx:id="currentUserLabel" text="@username" styleClass="current-username"/>
                        <Label fx:id="connectionStatusLabel" text="🟢 Connecting..." styleClass="connection-status"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Search Bar -->
            <HBox spacing="6">
                <TextField fx:id="searchField" promptText="Search users..." HBox.hgrow="ALWAYS" styleClass="search-field"/>
                <Button text="🔍" onAction="#handleSearchUser" styleClass="icon-button"/>
            </HBox>

            <!-- Contact List -->
            <VBox spacing="6" VBox.vgrow="ALWAYS">
                <Label text="DIRECT CONVERSATIONS" styleClass="section-label"/>
                <ListView fx:id="contactListView" VBox.vgrow="ALWAYS" styleClass="contact-list"/>
            </VBox>

            <!-- Logout -->
            <Button text="🚪 Sign Out" onAction="#handleLogout" maxWidth="Infinity" styleClass="logout-button"/>
        </VBox>
    </left>

    <!-- Main Chat Workspace -->
    <center>
        <VBox styleClass="chat-workspace">
            <!-- Chat Header -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="chat-header">
                <padding>
                    <Insets top="14" right="20" bottom="14" left="20"/>
                </padding>

                <VBox spacing="2">
                    <Label fx:id="chatHeaderLabel" text="Select a conversation" styleClass="active-peer-title"/>
                    <Label fx:id="peerPresenceLabel" text="Select a contact from the sidebar to chat" styleClass="peer-presence"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnSecurityDashboard" text="📊 Security Dashboard" onAction="#handleOpenSecurityDashboard"
                        styleClass="secondary-button" style="-fx-font-size: 11.5px; -fx-padding: 6 12;"/>
                <Button fx:id="btnSecurityInfo" text="🛡️ PQC Verification" onAction="#handleOpenSecurityInfo"
                        disable="true" styleClass="security-badge-button"/>
            </HBox>

            <!-- Message Stream Area -->
            <ScrollPane fx:id="messageScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                        styleClass="message-scroll-pane">
                <VBox fx:id="messageContainer" spacing="10" styleClass="message-container">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>
                </VBox>
            </ScrollPane>

            <!-- Input Bar -->
            <HBox alignment="CENTER" spacing="10" styleClass="chat-input-bar">
                <padding>
                    <Insets top="12" right="16" bottom="14" left="16"/>
                </padding>

                <Button fx:id="btnAttach" text="📎" onAction="#handleAttachFile"
                        disable="true" styleClass="icon-button"/>

                <TextField fx:id="messageInputField" promptText="Type an end-to-end encrypted message..."
                           onKeyPressed="#handleInputKeyPress" disable="true"
                           HBox.hgrow="ALWAYS" styleClass="message-input-field"/>

                <Button fx:id="btnSend" text="Send 🚀" onAction="#handleSendMessage"
                        disable="true" styleClass="send-button"/>

            </HBox>
        </VBox>
    </center>
</BorderPane>
