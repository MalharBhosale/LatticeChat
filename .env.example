# SecureChat Configuration Template
# Copy this file to .env and customize values. NEVER commit the actual .env file.

# Server Configuration
SERVER_PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=securechat_db
DB_USER=root
DB_PASSWORD=your_secure_password_here

# JWT Secret (Min 256 bits for HMAC-SHA256)
JWT_SECRET=replace_this_with_a_long_random_secret_key_at_least_32_bytes_long

# Security / Crypto Defaults
ML_KEM_PARAMETER_SET=ML-KEM-768
ML_DSA_PARAMETER_SET=ML-DSA-65
AES_KEY_SIZE_BITS=256
GCM_TAG_LENGTH_BITS=128
GCM_IV_LENGTH_BYTES=12 bytes
